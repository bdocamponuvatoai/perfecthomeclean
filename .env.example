# Public URL of the site, used for canonical links, Open Graph URLs, robots.txt and sitemap.xml.
# Falls back to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://www.example.com

# Set to "true" only after the owner approves launch. Until then every page is
# noindex,nofollow and robots.txt disallows all crawling. The build fails if this
# is "true" while the site URL is still localhost.
SITE_INDEXABLE=false
